{
  "pages": [
    "pages/workspace/workspace",
    "pages/settings/settings",
    "pages/models/models"
  ],
  "subpackages": [
    {
      "root": "subpkg/fx",
      "name": "fxcore",
      "pages": ["p/index"]
    },
    {
      "root": "subpkg/kernel",
      "name": "kernel",
      "pages": ["p/index"]
    }
  ],
  "window": {
    "navigationStyle": "custom",
    "navigationBarTitleText": "dsh",
    "navigationBarTextStyle": "@navigationBarTextStyle",
    "navigationBarBackgroundColor": "@navigationBarBackgroundColor",
    "backgroundColor": "@backgroundColor",
    "backgroundColorTop": "@backgroundColorTop",
    "backgroundColorBottom": "@backgroundColorBottom",
    "backgroundTextStyle": "@backgroundTextStyle"
  },
  "style": "v2",
  "darkmode": true,
  "themeLocation": "theme.json",
  "resizable": true,
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "preloadRule": {
    "pages/workspace/workspace": {
      "network": "all",
      "packages": ["subpkg/kernel"]
    },
    "pages/settings/settings": {
      "network": "all",
      "packages": ["subpkg/fx"]
    },
    "pages/models/models": {
      "network": "all",
      "packages": ["subpkg/fx"]
    }
  },
  "cloud": true,
  "dsh": {
    "localRuntimeRoute": "cloud"
  },
  "networkTimeout": {
    "request": 120000,
    "connectSocket": 20000,
    "uploadFile": 60000,
    "downloadFile": 60000
  }
}