{
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitAny": true,
    "module": "CommonJS",
    "target": "ES2020",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "strictPropertyInitialization": true,
    "lib": [
      "ES2020"
    ],
    "skipLibCheck": true,
    "types": [
      "miniprogram-api-typings"
    ]
  },
  "include": [
    "./skin/**/*.ts",
    "./app.ts",
    "./pages/**/*.ts",
    "./components/**/*.ts",
    "./services/**/*.ts",
    "./types/**/*.ts",
    "./utils/**/*.ts",
    "./typings/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "context",
    "docs"
  ]
}
