<view class="app {{isWide ? 'app-wide' : ''}}" style="{{appStyle}}">
  <!-- kernel 分包零闪引导：组件挂载即驱动分包下载+分包上下文 require，
       替代占位页 navigateTo（白闪根因）。display:none，无视觉成本。 -->
  <kernel-boot id="kernel-boot" style="display:none" />
  <view wx:if="{{!isWide && sidebarOpen}}" class="mask" data-anchor="workspace.mask" bindtap="closeSidebar"></view>

  <aside class="sidebar {{sidebarOpen ? 'sidebar-open' : ''}}">
    <view class="sidebar-top" style="padding-top: {{statusBarHeight}}px;">
      <view class="logo-row">
        <view class="brand-identity">
          <image class="brand-fish" src="{{theme === 'dark' ? '/assets/fish-white.png' : '/assets/fish.png'}}" mode="aspectFit" />
          <text class="brand-name">DeepSeek Harness</text>
        </view>
        <dsh-button class="sidebar-toggle" variant="icon" icon="panel-left-outline" iconSize="{{16}}" theme="{{theme}}" data-anchor="workspace.sidebar.toggle" bind:tap="toggleSidebar" />
      </view>

      <view class="new-session" data-anchor="workspace.newSession" bindtap="newSession">
        <dsh-icon name="new-chat-outline" theme="{{theme}}" size="{{18}}" />
        <text class="new-session-label">新会话</text>
      </view>
    </view>

    <!-- 搜索行不随会话列表滚动——永远钉在顶图层（业主 MN05）。 -->
    <view class="search-bar">
      <view class="search-filter sort-{{sortDesc ? 'desc' : 'asc'}}" data-anchor="workspace.sort.toggle" bindtap="onSortToggle">
        <dsh-icon name="clock-outline" theme="{{theme}}" size="{{15}}" />
        <view class="sort-caret"></view>
      </view>
      <view class="sidebar-search">
        <dsh-icon class="search-icon" name="search-outline" theme="{{theme}}" size="{{14}}" />
        <input
          class="search-input"
          data-anchor="workspace.search.input"
          value="{{query}}"
          placeholder="搜索{{sessionCount}}会话"
          placeholder-class="search-placeholder"
          adjust-position="{{false}}"
          bindinput="onSearch"
        />
      </view>
    </view>

    <!-- 会话列表独立滚动容器：溢出内部滚动；底部渐变层让临近设置区的文字淡出。 -->
    <view class="sidebar-list-wrap">
      <scroll-view class="sidebar-scroll" scroll-y show-scrollbar="{{false}}">
        <view class="session-list">
          <view
            wx:for="{{rows}}"
            wx:key="id"
            class="session-row {{item.id === currentId ? 'session-selected' : ''}}"
            data-anchor="session.row"
            data-id="{{item.id}}"
            bindtap="openSession"
          >
            <view class="row-main">
              <text class="row-title">{{item.title}}</text>
              <view class="row-meta">
                <text class="row-tag tag-{{item.statusTag.tone}}">{{item.statusTag.text}}</text>
                <text class="row-tag tag-time">{{item.timeLabel}}</text>
                <text class="row-runtime">{{item.statusLine}}</text>
              </view>
            </view>
            <view
              id="session-more-{{item.id}}"
              class="row-more"
              data-anchor="session.row.more"
              data-id="{{item.id}}"
              catchtap="onSessionMenu"
            >
              <dsh-icon name="ellipsis-outline" theme="{{theme}}" size="{{15}}" />
            </view>
          </view>
          <view wx:if="{{!rows.length}}" class="sidebar-empty">{{query ? '没有匹配的会话' : '还没有会话'}}</view>
        </view>
      </scroll-view>
      <view class="list-fade"></view>
    </view>

    <view class="sidebar-foot">
      <view class="foot-btns">
        <view class="foot-row" data-anchor="workspace.sidebar.accountSettings" bindtap="openAccountSettings">
          <dsh-icon name="user-outline" theme="{{theme}}" size="{{16}}" />
          <text>账户设置</text>
        </view>
        <view class="foot-row" data-anchor="workspace.sidebar.modelConfig" bindtap="openModelConfig">
          <dsh-icon name="layers-outline" theme="{{theme}}" size="{{16}}" />
          <text>模型配置</text>
        </view>
      </view>
      <view class="foot-meta">{{runtimeLabel}} · v{{version}}</view>
    </view>
  </aside>

  <main class="main">
    <header class="header {{showHero ? 'header-blank' : ''}}" style="padding-top: {{statusBarHeight}}px; padding-right: {{capsuleInsetRight}}px; position: relative;">
      <view class="header-row" style="height: {{navBarContentHeight}}px;">
        <view class="header-leading">
          <dsh-button wx:if="{{!isWide}}" class="header-menu" variant="icon" icon="panel-left-outline" iconSize="{{16}}" theme="{{theme}}" data-anchor="workspace.header.menu" bind:tap="toggleSidebar" />
          <view wx:if="{{!showHero}}" class="crumbs">
            <text wx:if="{{isWide}}" class="crumb">{{workspaceName}}</text>
            <text wx:if="{{isWide}}" class="crumb-sep">/</text>
            <text class="crumb crumb-current">{{title}}</text>
          </view>
        </view>

        <view class="header-actions">
          <dsh-button variant="icon" data-anchor="workspace.rightPanel.toggle" bind:tap="toggleRightPanel">
            <view class="flip-horizontal">
              <dsh-icon name="panel-left-outline" theme="{{theme}}" size="{{16}}" />
            </view>
          </dsh-button>
          <dsh-button
            wx:if="{{!showHero}}"
            id="header-session-menu"
            variant="icon"
            icon="ellipsis-outline"
            iconSize="{{16}}"
            theme="{{theme}}"
            data-anchor="workspace.sessionMenu"
            bind:tap="openHeaderSessionMenu"
          />
        </view>
      </view>

      <dsh-tabs wx:if="{{!showHero}}" variant="underline" tabs="{{viewTabs}}" active="{{view}}" data-anchor="workspace.tabs" bind:change="onViewChange" />

      <view wx:if="{{needUnlock}}" class="unlock-banner" data-anchor="banner.unlock" bindtap="onUnlockSync">
        <dsh-icon name="warning-triangle-outline" tone="warn" theme="{{theme}}" size="{{14}}" />
        <text class="unlock-banner-text">云端同步未解锁，点此验证以恢复同步</text>
        <dsh-icon
          wx:if="{{unlocking}}"
          class="unlock-banner-spin"
          name="loading-outline"
          theme="{{theme}}"
          size="{{14}}"
        />
        <dsh-icon wx:else name="chevron-right-outline" theme="{{theme}}" size="{{12}}" />
      </view>
    </header>

    <trajectory-view
      wx:if="{{!showHero && view === 'trajectory'}}"
      id="trajectory"
      class="trajectory-host"
      items="{{state.current.items}}"
      wide="{{windowWidth >= 900}}"
      theme="{{theme}}"
    />

    <scroll-view
      wx:else
      id="chat-scroll"
      class="viewport"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollTarget}}"
      scroll-with-animation
      data-anchor="chat.scroll"
      bindscroll="onChatScroll"
    >
      <view wx:if="{{!state.current && !showHero}}" class="hero">
        <text class="view-loading">正在打开会话…</text>
      </view>

      <view wx:elif="{{showHero}}" class="hero">
        <view class="hero-stack">
          <view class="hero-headline">
            <image class="hero-fish" src="{{theme === 'dark' ? '/assets/fish-white.png' : '/assets/fish.png'}}" mode="aspectFit" />
            <view class="hero-title-group">
              <text class="hero-title">探索未至之境</text>
              <text class="hero-badge">预览版</text>
            </view>
          </view>

          <view class="hero-body">
            <view id="workspace-menu-button" class="workspace-chip" data-anchor="workspace.engineChip" bindtap="openWorkspaceMenu">
              <dsh-icon name="folder-open-outline" theme="{{theme}}" size="{{16}}" />
              <text class="workspace-chip-label">{{engineChipLabel}}</text>
              <dsh-icon name="chevron-down-outline" theme="{{theme}}" size="{{12}}" />
            </view>
            <approval-sheet
              wx:if="{{approval !== null}}"
              visible="{{approval !== null}}"
              request="{{approval}}"
              theme="{{theme}}"
              bind:respond="onApprovalRespond"
            />
            <question-sheet
              wx:if="{{question !== null}}"
              visible="{{question !== null}}"
              request="{{question}}"
              theme="{{theme}}"
              bind:submit="onQuestionSubmit"
              bind:close="onQuestionClose"
            />
            <view class="composer-stack">
            <goal-bar
              wx:if="{{goal}}"
              goal="{{goal}}"
              theme="{{theme}}"
              bind:edit="onGoalEdit"
              bind:clear="onGoalClear"
            />
            <view id="composer-anchor" class="composer-anchor">
            <composer-bar
              id="composer"
              hero="{{true}}"
              theme="{{theme}}"
              value="{{input}}"
              placeholder="{{heroPlaceholder}}"
              model-label="{{modelLabel}}"
              running="{{state.current && state.current.status === 'running'}}"
              sending="{{state.sending}}"
              images="{{pendingImages}}"
              permission-label="{{permissionLabel}}"
              plan-mode="{{planMode}}"
              bind:input="onComposerInput"
              bind:send="send"
              bind:stop="stop"
              bind:command="openCommandMenu"
              bind:permission="openPermissionMenu"
              bind:model="openModelPicker"
              bind:removeimage="removeImage"
            />
            </view>
            </view>
          </view>
        </view>
      </view>

      <block wx:elif="{{view === 'chat'}}">
        <view class="chat-column">
          <view
            wx:for="{{displayItems}}"
            wx:key="id"
            id="msg-{{item.id}}"
            class="message-wrap"
            hidden="{{!item.turnLabel && item.processHidden}}"
          >
            <view
              wx:if="{{item.turnLabel}}"
              class="turn-process {{item.turnCollapsible && !item.turnCollapsed ? 'turn-process-open' : ''}}"
              data-anchor-exempt="fold"
              data-turn="{{item.turnCollapsible ? item.turn : 0}}"
              catchtap="toggleTurn"
            >
              <text class="turn-label">{{item.turnLabel}}</text>
              <dsh-icon wx:if="{{item.turnCollapsible}}" class="turn-chevron" name="chevron-down-outline" tone="tertiary" theme="{{theme}}" size="{{14}}" />
            </view>
            <chat-bubble
              wx:if="{{!item.processHidden}}"
              item="{{item}}"
              theme="{{theme}}"
              ratings="{{feedbackRatings}}"
              bind:feedback="onMessageFeedback"
              bind:branch="branchMessage"
              bind:inspect="inspectToolCall"
            />
          </view>

          <view wx:if="{{state.current && (state.current.status === 'running' || state.streaming)}}" id="stream-anchor" class="running-row">
            <image class="running-icon" src="/assets/running-whale.png" mode="aspectFit" />
            <view class="running-copy">
              <text class="running-text">{{runLabel}}</text>
              <text class="running-shimmer">{{runLabel}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 键盘升起时锚点增 kb 高——尾消息落在键盘上沿之上（dock 手动抬升配套）。 -->
      <view class="bottom-anchor" style="height: {{24 + kb}}px;"></view>
    </scroll-view>

    <view wx:if="{{isWide && turnMarks.length}}" class="turn-rail">
      <view
        wx:for="{{turnMarks}}"
        wx:key="turn"
        class="turn-mark {{item.active ? 'turn-mark-active' : ''}} {{item.active && state.current && state.current.status === 'running' ? 'turn-mark-busy' : ''}}"
        data-anchor="turnrail.mark"
        data-target="{{item.target}}"
        bindtap="jumpToTurn"
      ></view>
    </view>

    <view wx:if="{{state.current && !showHero}}" class="composer-dock safe-bottom {{view === 'trajectory' ? 'composer-dock-trajectory' : ''}}" style="transform: translateY(-{{kb}}px);">
      <view class="composer-dock-inner">
        <approval-sheet
          wx:if="{{approval !== null}}"
          visible="{{approval !== null}}"
          request="{{approval}}"
          theme="{{theme}}"
          bind:respond="onApprovalRespond"
        />
        <question-sheet
          wx:if="{{question !== null}}"
          visible="{{question !== null}}"
          request="{{question}}"
          theme="{{theme}}"
          bind:submit="onQuestionSubmit"
          bind:close="onQuestionClose"
        />
        <view class="composer-stack">
        <goal-bar
          wx:if="{{goal}}"
          goal="{{goal}}"
          theme="{{theme}}"
          bind:edit="onGoalEdit"
          bind:clear="onGoalClear"
        />
        <view id="composer-anchor" class="composer-anchor">
        <composer-bar
          id="composer"
          hero="{{false}}"
          theme="{{theme}}"
          value="{{input}}"
          placeholder="{{dockedPlaceholder}}"
          model-label="{{modelLabel}}"
          running="{{state.current && state.current.status === 'running'}}"
          sending="{{state.sending}}"
          images="{{pendingImages}}"
          permission-label="{{permissionLabel}}"
          plan-mode="{{planMode}}"
          bind:input="onComposerInput"
          bind:send="send"
          bind:stop="stop"
          bind:command="openCommandMenu"
          bind:permission="openPermissionMenu"
          bind:model="openModelPicker"
          bind:removeimage="removeImage"
        />
        </view>
        </view>
        <view wx:if="{{!showHero && view === 'chat' && !atTail}}" class="to-bottom" data-anchor="workspace.toBottom" bindtap="scrollToBottom">
          <dsh-icon name="chevron-down-outline" tone="primary" theme="{{theme}}" size="{{16}}" />
        </view>
        <!-- stats dock：dsh composer.dock 投影——左统计 pill，右上下文占比环。 -->
        <view wx:if="{{statsDock && view === 'chat'}}" class="stats-dock" data-anchor="stats.dock">
          <view class="stats-pills">
            <view class="stats-pill" data-anchor="stats.activity">
              <dsh-icon name="gauge-outline" tone="tertiary" theme="{{theme}}" size="{{12}}" />
              <text class="stats-pill-label">{{statsDock.activity}}</text>
            </view>
            <view wx:if="{{statsDock.usage}}" class="stats-pill stats-pill-usage" data-anchor="stats.usage">
              <dsh-icon name="api-outline" tone="tertiary" theme="{{theme}}" size="{{12}}" />
              <text class="stats-pill-label">{{statsDock.usage}}</text>
            </view>
          </view>
          <view wx:if="{{statsDock.contextPercent !== undefined}}" class="stats-context" data-anchor="stats.context">
            <view class="stats-ring" style="background: conic-gradient(var(--dsw-alias-label-tertiary) {{statsDock.contextPercent * 3.6}}deg, var(--dsw-alias-border-l3) 0);">
              <view class="stats-ring-hole"></view>
            </view>
            <text class="stats-context-label">{{statsDock.contextPercent}}%</text>
          </view>
        </view>
      </view>
    </view>
  </main>

  <command-menu
    id="command-menu"
    visible="{{commandMenuVisible}}"
    query="{{commandMenuQuery}}"
    surface-style="{{commandMenuStyle}}"
    max-height="{{commandMenuMaxHeight}}"
    theme="{{theme}}"
    bind:select="onCommandSelect"
    bind:close="closeCommandMenu"
  />
  <model-picker
    visible="{{modelPickerVisible}}"
    models="{{models}}"
    current="{{model}}"
    provider-label="DeepSeek"
    surface-style="{{modelPickerStyle}}"
    theme="{{theme}}"
    bind:select="onModelSelect"
    bind:close="closeModelPicker"
  />
  <right-panel
    id="right-panel"
    class="rp-host"
    visible="{{rightOpen}}"
    docked="{{isDesktop}}"
    active="{{rightTab}}"
    tabs="{{rightTabs}}"
    theme="{{theme}}"
    files="{{rightFiles}}"
    todos="{{rightTodos}}"
    loading="{{rightLoading}}"
    error="{{rightError}}"
    connected="{{nanoConnected}}"
    session-id="{{currentId}}"
    bind:select="selectRightTab"
    bind:refresh="refreshRightPanel"
    bind:close="closeRightPanel"
  />

  <dsh-menu
    visible="{{menuVisible}}"
    items="{{menuItems}}"
    title="{{menuTitle}}"
    surface-style="{{menuStyle}}"
    theme="{{theme}}"
    bind:close="closeMenu"
    bind:select="onMenuSelect"
  />
  <!-- 向上弹窗抽屉 upDrawer：新会话 runtime 选择（本地/云端引擎）。 -->
  <up-drawer
    visible="{{engineDrawerVisible}}"
    title="新会话引擎"
    subtitle="选择下一次新建会话的运行时"
    theme="{{theme}}"
    bind:close="closeEngineDrawer"
  >
    <view class="upd-fill">
      <scroll-view class="engine-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{engineOptions}}"
          wx:key="id"
          class="engine-option {{item.disabled ? 'engine-option-disabled' : ''}}"
          hover-class="{{item.disabled ? '' : 'engine-option-hover'}}"
          data-anchor="engine.option"
          data-id="{{item.id}}"
          bindtap="onEnginePick"
        >
          <view class="engine-option-icon">
            <dsh-icon name="{{item.icon}}" theme="{{theme}}" size="{{18}}" />
          </view>
          <view class="engine-option-text">
            <view class="engine-option-labelrow">
              <text class="engine-option-label">{{item.label}}</text>
              <text wx:if="{{item.badge}}" class="engine-option-badge">{{item.badge}}</text>
            </view>
            <text class="engine-option-desc">{{item.description}}</text>
          </view>
          <view class="engine-option-check">
            <dsh-icon wx:if="{{item.checked}}" name="check-outline" theme="{{theme}}" size="{{16}}" />
          </view>
        </view>
      </scroll-view>
    </view>
  </up-drawer>
  <feedback-dialog
    visible="{{feedbackVisible}}"
    theme="{{theme}}"
    rating="{{feedbackRating}}"
    target="{{feedbackTarget}}"
    bind:cancel="closeFeedback"
    bind:submit="onFeedbackSubmit"
  />
  <dsh-dialog
    visible="{{dialogVisible}}"
    theme="{{theme}}"
    tone="{{dialogTone}}"
    title="{{dialogTitle}}"
    description="{{dialogDescription}}"
    editable="{{dialogEditable}}"
    multiline="{{dialogMultiline}}"
    value="{{dialogValue}}"
    placeholder="{{dialogPlaceholder}}"
    cancel-text="取消"
    confirm-text="{{dialogConfirmText}}"
    danger="{{dialogDanger}}"
    confirm-disabled="{{dialogAction === 'permission-auto' && !riskAck}}"
    bind:confirm="onDialogConfirm"
    bind:cancel="closeDialog"
  >
    <view wx:if="{{dialogAction === 'permission-auto'}}" class="dialog-risk">
      <dsh-switch checked="{{riskAck}}" data-anchor="dialog.riskAck" bind:change="onRiskAck" />
      <text class="dialog-risk-text">我已了解自动审查的风险</text>
    </view>
  </dsh-dialog>
  <dsh-toast
    visible="{{toastVisible}}"
    message="{{toastMessage}}"
    tone="{{toastTone}}"
    theme="{{theme}}"
    bind:close="closeToast"
  />
  <error-center
    toasts="{{errToasts}}"
    modal="{{errModal}}"
    pending="{{errPending}}"
    theme="{{theme}}"
    bind:closetoast="onErrToastClose"
    bind:detail="onErrDetail"
    bind:closemodal="onErrModalClose"
    bind:copied="onErrCopied"
    bind:copyfailed="onErrCopyFailed"
  />
</view>
