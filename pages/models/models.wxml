<view class="settings-page theme-{{theme}}" style="{{appStyle}}">
  <view class="settings-overlay">
    <view class="settings-mask" data-anchor="models.mask" bindtap="back"></view>

    <view class="settings-panel">
      <view class="settings-title">
        <text>模型配置</text>
        <view class="settings-close" data-anchor="models.close" bindtap="back">
          <dsh-icon name="close-outline" theme="{{theme}}" size="{{13}}" />
        </view>
      </view>

      <view class="settings-header" style="padding-right: {{capsuleInsetRight}}px;"></view>

      <view class="settings-nav">
        <view class="settings-nav-list">
          <view
            wx:for="{{sections}}"
            wx:key="id"
            class="nav-cell {{activeId === item.id ? 'nav-cell-active' : ''}}"
            data-anchor="models.nav.item"
            data-id="{{item.id}}"
            bindtap="selectSection"
          >
            <dsh-icon class="nav-icon" name="{{item.icon}}" theme="{{theme}}" size="{{16}}" />
            <text class="nav-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <scroll-view class="settings-options" scroll-y enhanced show-scrollbar="{{false}}">
        <block wx:if="{{activeId === 'models'}}">
          <view class="section-head">
            <view class="section-title">模型</view>
            <view class="section-desc">选择新会话使用的默认模型</view>
          </view>

          <view
            wx:for="{{models}}"
            wx:key="id"
            class="model-row {{model === item.id ? 'model-row-active' : ''}}"
            data-anchor="models.row"
            data-id="{{item.id}}"
            bindtap="selectModel"
          >
            <view class="model-copy">
              <view class="model-name">{{item.label}}</view>
              <view class="model-desc">{{item.description}}</view>
            </view>
            <view class="model-radio">
              <dsh-icon wx:if="{{model === item.id}}" name="check-outline" tone="accent" theme="{{theme}}" size="{{14}}" />
            </view>
          </view>
        </block>

        <block wx:elif="{{activeId === 'providers'}}">
          <view class="section-head">
            <view class="section-title">供应商</view>
            <view class="section-desc">本地运行时密钥托管 · 路由：{{routeLabel}}</view>
          </view>

          <view class="provider-row">
            <view class="provider-mark">
              <dsh-icon name="globe-outline" theme="{{theme}}" size="{{14}}" />
            </view>
            <view class="model-copy">
              <view class="model-name">magpie</view>
              <view class="model-desc">OpenAI 兼容端点 · 信封加密托管 · 按 openid 隔离</view>
            </view>
            <text class="provider-status">{{enrolled ? '已注入' : (fxRoute === 'local' ? '直连' : '未注入')}}</text>
          </view>

          <block wx:if="{{fxRoute === 'local'}}">
            <view class="field">
              <view class="field-label">本地直连模式</view>
              <view class="field-hint">当前经 .local.development.json 直连供应商，不经云端托管；切换到云端路由后可在此注入密钥。</view>
            </view>
          </block>
          <block wx:else>
            <view class="field">
              <view class="field-label">生物识别门禁</view>
              <view class="field-hint">{{bioText}}</view>
            </view>

            <block wx:if="{{enrolled}}">
              <view class="profile-card">
                <view class="profile-avatar">k</view>
                <view class="profile-copy">
                  <view class="profile-name">{{enrolledProvider}} · 已托管</view>
                  <view class="profile-sub">{{enrolledBaseUrl}}</view>
                </view>
                <view class="profile-dot"></view>
              </view>
              <view class="field">
                <view class="field-label">注入信息</view>
                <view class="field-hint">模型 {{enrollModel}} · {{enrolledAt}} · 密钥密文仅存云端，本机不留明文</view>
              </view>
              <view class="field action-row" data-anchor="models.revokeProvider" bindtap="revokeProvider">
                <view class="field-copy">
                  <view class="field-label">撤回注入</view>
                  <view class="field-hint">删除云端密钥记录并清除本机登记</view>
                </view>
                <text class="action-danger">撤回</text>
              </view>
            </block>
            <block wx:else>
              <view class="field auth-field">
                <view class="field-label">注入供应商密钥</view>
                <view class="field-hint">密钥经 TLS 上行后信封加密存于云端（按 openid 隔离），本机不留存明文。生效模型：{{injectModelLabel}}（在「模型」中切换）。无生物识别时禁止注入。</view>
                <input
                  class="settings-input"
                  data-anchor="models.enroll.baseUrl"
                  value="{{baseUrl}}"
                  placeholder="供应商地址（base_url）"
                  placeholder-class="settings-placeholder"
                  type="text"
                  bindinput="onBaseUrlInput"
                />
                <input
                  class="settings-input"
                  data-anchor="models.enroll.apiKey"
                  value="{{apiKey}}"
                  password
                  placeholder="API Key（供应商无鉴权时可留空）"
                  placeholder-class="settings-placeholder"
                  bindinput="onApiKeyInput"
                />
                <view class="auth-actions">
                  <dsh-button class="auth-submit {{(!bioOk || enrollBusy) ? 'auth-busy' : ''}}" variant="primary" label="{{enrollBusy ? '注入中…' : (bioOk ? '生物验证并注入' : '生物识别不可用')}}" data-anchor="models.enroll.submit" bind:tap="submitEnroll" />
                </view>
                <view wx:if="{{enrollError}}" class="auth-error">{{enrollError}}</view>
              </view>
            </block>
          </block>
        </block>

        <block wx:elif="{{activeId === 'storage'}}">
          <view class="section-head">
            <view class="section-title">存储</view>
            <view class="section-desc">工作区五根 VFS · 对象后端占位（rules/filesystem.md）</view>
          </view>

          <view class="provider-row">
            <view class="provider-mark">
              <dsh-icon name="folder-open-outline" theme="{{theme}}" size="{{14}}" />
            </view>
            <view class="model-copy">
              <view class="model-name">本地对象层</view>
              <view class="model-desc">USER_DATA_PATH content-addressed · placement=local-*（cache-tier 非 durable 承诺）</view>
            </view>
            <text class="provider-status">生效中</text>
          </view>

          <view class="field auth-field">
            <view class="field-label">S3 对象后端（占位 · 未启用）</view>
            <view class="field-hint">合约先行：登记 endpoint/bucket 后，后续版本可将 /root 与 /data 行的 placement 升级为 s3-pinned。密钥不落本机——access key 将走供应商同一条云端托管管道。当前配置不产生任何网络请求。</view>
            <input
              class="settings-input"
              data-anchor="models.s3.endpoint"
              value="{{s3Endpoint}}"
              placeholder="endpoint（如 s3.example.com）"
              placeholder-class="settings-placeholder"
              type="text"
              bindinput="onS3EndpointInput"
            />
            <input
              class="settings-input"
              data-anchor="models.s3.bucket"
              value="{{s3Bucket}}"
              placeholder="bucket"
              placeholder-class="settings-placeholder"
              type="text"
              bindinput="onS3BucketInput"
            />
            <input
              class="settings-input"
              data-anchor="models.s3.region"
              value="{{s3Region}}"
              placeholder="region（可选，默认 auto）"
              placeholder-class="settings-placeholder"
              type="text"
              bindinput="onS3RegionInput"
            />
            <view class="auth-actions">
              <dsh-button class="auth-submit" variant="primary" label="登记配置" data-anchor="models.s3.save" bind:tap="saveS3Config" />
            </view>
            <view wx:if="{{s3Error}}" class="auth-error">{{s3Error}}</view>
            <view wx:if="{{s3Configured}}" class="field-hint">已登记 · {{s3ConfiguredAt}} · 后端仍未启用（s3-pinned 写入将返回 backend-unavailable）</view>
          </view>

          <view wx:if="{{s3Configured}}" class="field action-row" data-anchor="models.s3.clear" bindtap="clearS3Config">
            <view class="field-copy">
              <view class="field-label">清除 S3 配置</view>
              <view class="field-hint">移除登记的 endpoint/bucket/region</view>
            </view>
            <text class="action-danger">清除</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <dsh-toast
    visible="{{toastVisible}}"
    message="{{toastMessage}}"
    tone="{{toastTone}}"
    theme="{{theme}}"
    bind:close="closeToast"
  />
  <error-center
    toasts="{{errToasts}}"
    modal="{{errModal}}"
    pending="{{errPending}}"
    theme="{{theme}}"
    bind:closetoast="onErrToastClose"
    bind:detail="onErrDetail"
    bind:closemodal="onErrModalClose"
    bind:copied="onErrCopied"
    bind:copyfailed="onErrCopyFailed"
  />
</view>
