<view wx:if="{{goal}}" class="goal-dock layout-{{layout}}" style="{{shellVars}}">
  <view wx:if="{{!editing}}" class="goal-bar">
    <view class="goal-glyph">
      <dsh-icon name="goal-outline" tone="tertiary" theme="{{theme}}" size="{{14}}" />
    </view>
    <text class="goal-label">进行中的目标</text>
    <text class="goal-objective">{{goal}}</text>
    <view class="goal-actions">
      <view class="goal-icon" data-anchor="goal.edit" bindtap="startEdit">
        <dsh-icon name="edit-outline" theme="{{theme}}" size="{{14}}" />
      </view>
      <view class="goal-icon" data-anchor="goal.clear" bindtap="clear">
        <dsh-icon name="trash-outline" theme="{{theme}}" size="{{14}}" />
      </view>
    </view>
  </view>

  <view wx:else class="goal-bar goal-edit-bar">
    <textarea
      class="goal-input goal-input-area"
      value="{{draft}}"
      focus
      auto-height
      maxlength="-1"
      adjust-position="{{false}}"
      show-confirm-bar="{{false}}"
      placeholder="描述目标"
      placeholder-class="goal-placeholder"
      data-anchor="goal.input" bindinput="onInput"
    />
    <view class="goal-actions">
      <view class="goal-icon" data-anchor="goal.save" bindtap="save">
        <dsh-icon name="check-outline" theme="{{theme}}" size="{{14}}" />
      </view>
      <view class="goal-icon" data-anchor="goal.cancel" bindtap="cancel">
        <dsh-icon name="close-outline" theme="{{theme}}" size="{{14}}" />
      </view>
    </view>
  </view>
</view>
