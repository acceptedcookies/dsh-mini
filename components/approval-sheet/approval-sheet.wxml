<view wx:if="{{visible && request.id}}" class="approval-card">
  <view class="approval-strip">
    <dsh-icon name="warning-triangle-outline" tone="warn" theme="{{theme}}" size="{{14}}" />
    <text>需要你的批准</text>
  </view>
  <view class="approval-body">
    <view class="approval-headline">Agent 请求执行敏感操作</view>
    <view class="approval-command">{{request.toolName}}<text wx:if="{{request.callId}}"> · {{request.callId}}</text></view>
    <view wx:if="{{request.reason}}" class="approval-reason">{{request.reason}}</view>
    <view class="approval-actions">
      <view class="approval-action approval-reject" bindtap="reject">拒绝</view>
      <view class="approval-action approval-allow" bindtap="allow">
        <dsh-icon name="check-outline" tone="inverse" theme="{{theme}}" size="{{14}}" />
        <text>允许一次</text>
      </view>
    </view>
  </view>
</view>
