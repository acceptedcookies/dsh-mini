<view wx:if="{{visible && request.id}}" class="approval-card">
  <view class="approval-strip">
    <view class="approval-dot {{answered ? 'approval-dot-ongoing' : ''}}"></view>
    <text>等待审批</text>
  </view>
  <view class="approval-body">
    <view class="approval-headline">{{request.reason || ('工具 ' + request.toolName + ' 请求越权执行')}}</view>
    <view wx:if="{{request.callId}}" class="approval-command">{{request.callId}}</view>
  </view>
  <view class="approval-actions">
    <view class="approval-action approval-reject {{answered ? 'approval-action-disabled' : ''}}" data-anchor="approval.reject" bindtap="reject">拒绝</view>
    <view class="approval-action approval-allow {{answered ? 'approval-action-disabled' : ''}}" data-anchor="approval.allow" bindtap="allow">允许一次</view>
  </view>
</view>
