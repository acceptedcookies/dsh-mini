<view class="ec-root theme-{{theme}}">
  <view class="ec-toast-stack">
    <view
      wx:for="{{toastViews}}"
      wx:key="id"
      class="ec-toast ec-toast-{{item.severity}}"
    >
      <dsh-icon class="ec-toast-icon" name="{{item.iconName}}" tone="{{item.iconTone}}" theme="{{theme}}" size="{{16}}" />
      <view class="ec-toast-body" data-id="{{item.id}}" catchtap="onOpenDetail">
        <text class="ec-toast-title">{{item.title}}</text>
        <text class="ec-toast-msg">{{item.message}}{{item.count > 1 ? '（×' + item.count + '）' : ''}}</text>
      </view>
      <view class="ec-toast-detail" data-id="{{item.id}}" catchtap="onOpenDetail">详情</view>
      <view class="ec-toast-close" data-id="{{item.id}}" catchtap="onDismissToast">
        <dsh-icon name="close-outline" tone="secondary" theme="{{theme}}" size="{{13}}" />
      </view>
    </view>
    <view wx:if="{{pending > 0}}" class="ec-more">还有 {{pending}} 条错误待显示</view>
  </view>

  <view wx:if="{{modal}}" class="ec-modal-layer" catchtouchmove="noop">
    <view class="ec-modal-mask" bindtap="onCloseModal"></view>
    <view class="ec-modal-card" catchtap="noop">
      <view class="ec-modal-head">
        <view class="ec-modal-title">
          <dsh-icon name="{{modalIconName}}" tone="{{modalIconTone}}" theme="{{theme}}" size="{{18}}" />
          <text class="ec-modal-title-text">{{modal.title}}</text>
          <text class="ec-modal-code">{{modal.code}}</text>
        </view>
        <view class="ec-modal-close" bindtap="onCloseModal">
          <dsh-icon name="close-outline" tone="secondary" theme="{{theme}}" size="{{14}}" />
        </view>
      </view>

      <text class="ec-modal-msg">{{modal.message}}</text>
      <text wx:if="{{modal.hint}}" class="ec-modal-hint">{{modal.hint}}</text>

      <scroll-view scroll-y class="ec-modal-diag" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{modalRows}}" wx:key="k" class="ec-diag-row">
          <text class="ec-diag-k">{{item.k}}</text>
          <text class="ec-diag-v" selectable>{{item.v}}</text>
        </view>
        <text wx:if="{{modalDetail}}" class="ec-diag-detail" selectable>{{modalDetail}}</text>
      </scroll-view>

      <view class="ec-modal-foot">
        <dsh-button variant="default" size="sm" icon="copy-outline" iconSize="{{14}}" label="复制错误全文" theme="{{theme}}" bind:tap="onCopy" />
        <dsh-button variant="primary" size="sm" label="关闭" theme="{{theme}}" bind:tap="onCloseModal" />
      </view>
    </view>
  </view>
</view>
