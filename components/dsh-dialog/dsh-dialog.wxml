<view wx:if="{{render}}" class="dialog-layer {{closing ? 'dialog-closing' : ''}}" style="{{kb > 0 ? 'padding-bottom: calc(' + kb + 'px + 16px)' : ''}}" catchtouchmove="noop" data-anchor-exempt="gesture-shield">
  <view class="dialog-mask" data-anchor="dialog.mask" bindtap="cancel"></view>
  <view class="layout-{{layout}} dialog-card dialog-{{tone}}" data-anchor-exempt="gesture-shield" catchtap="noop" style="{{shellVars}}">
    <view class="dialog-header">
      <view class="dialog-title">
        <dsh-icon wx:if="{{tone === 'warning'}}" name="warning-outline" tone="warn" theme="{{theme}}" size="{{18}}" />
        <text>{{title}}</text>
      </view>
      <view class="dialog-close" data-anchor="dialog.close" bindtap="cancel">
        <dsh-icon name="close-outline" tone="secondary" theme="{{theme}}" size="{{14}}" />
      </view>
    </view>

    <text wx:if="{{description}}" class="dialog-description">{{description}}</text>

    <view class="dialog-body">
      <input
        wx:if="{{editable && !multiline}}"
        class="dialog-input"
        data-anchor="dialog.input"
        value="{{draft}}"
        focus="{{visible && editable}}"
        placeholder="{{placeholder}}"
        placeholder-class="dialog-placeholder"
        confirm-type="done"
        adjust-position="{{false}}"
        bindinput="onInput"
        bindconfirm="confirm"
      />
      <textarea
        wx:elif="{{editable && multiline}}"
        class="dialog-input dialog-textarea"
        data-anchor="dialog.textarea"
        value="{{draft}}"
        focus="{{visible && editable}}"
        placeholder="{{placeholder}}"
        placeholder-class="dialog-placeholder"
        auto-height
        maxlength="-1"
        show-confirm-bar="{{false}}"
        adjust-position="{{false}}"
        bindinput="onInput"
      />
      <slot></slot>
    </view>

    <view class="dialog-footer">
      <view class="dialog-button" data-anchor="dialog.cancel" bindtap="cancel">{{cancelText}}</view>
      <view wx:if="{{confirmText}}" data-anchor="dialog.confirm" class="dialog-button dialog-button-primary {{danger ? 'dialog-button-danger' : ''}} {{confirmDisabled ? 'dialog-button-disabled' : ''}}" bindtap="confirm">{{confirmText}}</view>
    </view>
  </view>
</view>
