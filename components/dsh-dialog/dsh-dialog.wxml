<view wx:if="{{render}}" class="dialog-layer theme-{{theme}} {{closing ? 'dialog-closing' : ''}}" catchtouchmove="noop">
  <view class="dialog-mask" bindtap="cancel"></view>
  <view class="dialog-card dialog-{{tone}}" catchtap="noop">
    <view class="dialog-header">
      <view class="dialog-title">
        <dsh-icon wx:if="{{tone === 'warning'}}" name="warning-outline" tone="warn" theme="{{theme}}" size="{{18}}" />
        <text>{{title}}</text>
      </view>
      <view class="dialog-close" bindtap="cancel">
        <dsh-icon name="close-outline" tone="secondary" theme="{{theme}}" size="{{14}}" />
      </view>
    </view>

    <text wx:if="{{description}}" class="dialog-description">{{description}}</text>

    <view class="dialog-body">
      <input
        wx:if="{{editable}}"
        class="dialog-input"
        value="{{draft}}"
        focus="{{visible && editable}}"
        placeholder="{{placeholder}}"
        placeholder-class="dialog-placeholder"
        confirm-type="done"
        bindinput="onInput"
        bindconfirm="confirm"
      />
      <slot></slot>
    </view>

    <view class="dialog-footer">
      <view class="dialog-button" bindtap="cancel">{{cancelText}}</view>
      <view wx:if="{{confirmText}}" class="dialog-button dialog-button-primary {{danger ? 'dialog-button-danger' : ''}} {{confirmDisabled ? 'dialog-button-disabled' : ''}}" bindtap="confirm">{{confirmText}}</view>
    </view>
  </view>
</view>
