<view class="reasoning layout-{{layout}}" style="{{shellVars}}">
  <view class="reasoning-head" data-anchor-exempt="fold" bindtap="toggle">
    <view class="reasoning-leading">
      <dsh-icon
        tone="tertiary"
        wx:if="{{expanded}}"
        name="chevron-up-outline"
        theme="{{theme}}"
        size="{{14}}"
      />
      <dsh-icon wx:else tone="tertiary" name="think-outline" theme="{{theme}}" size="{{14}}" />
    </view>
    <text class="reasoning-title">思考</text>
    <block wx:if="{{!expanded && summary}}">
      <view class="reasoning-sep"></view>
      <view class="reasoning-summary-wrap {{running ? 'reasoning-summary-live' : ''}}">
        <text class="reasoning-summary">{{summary}}</text>
        <text wx:if="{{running}}" class="reasoning-summary reasoning-shimmer">{{summary}}</text>
      </view>
    </block>
  </view>
  <view wx:if="{{expanded}}" class="reasoning-body">
    <markdown-view text="{{text}}" theme="{{theme}}" />
  </view>
</view>
