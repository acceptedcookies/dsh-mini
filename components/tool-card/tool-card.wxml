<view class="tool-card layout-{{layout}}" style="{{shellVars}}">
  <view class="tool-head" data-anchor-exempt="fold" bindtap="toggle">
    <view class="tool-leading">
      <dsh-icon
        tone="tertiary"
        wx:if="{{expanded && view.expandable}}"
        name="chevron-up-outline"
        theme="{{theme}}"
        size="{{14}}"
      />
      <dsh-icon wx:else tone="tertiary" name="{{view.icon || 'sparkle'}}" theme="{{theme}}" size="{{14}}" />
    </view>
    <view class="tool-copy">
      <text class="tool-title">{{view.title}}</text>
      <block wx:if="{{view.summary}}">
        <view class="tool-sep"></view>
        <text
          class="tool-summary {{view.failed ? 'tool-summary-error' : view.stopped ? 'tool-summary-stopped' : ''}}"
        >{{view.summary}}</text>
      </block>
    </view>
    <view wx:if="{{view.running}}" class="tool-copy tool-shimmer">
      <text class="tool-title">{{view.title}}</text>
      <block wx:if="{{view.summary}}">
        <view class="tool-sep"></view>
        <text class="tool-summary">{{view.summary}}</text>
      </block>
    </view>
  </view>

  <view wx:if="{{expanded && view.expandable}}" class="tool-body">
    <view wx:if="{{view.input}}" class="tool-io-section">
      <text class="tool-io-label">输入</text>
      <scroll-view scroll-y class="tool-io-scroll">
        <text class="tool-io-text mono">{{view.input}}</text>
      </scroll-view>
    </view>
    <view wx:if="{{view.input && view.output}}" class="tool-io-divider"></view>
    <view wx:if="{{view.output}}" class="tool-io-section">
      <text class="tool-io-label">输出</text>
      <scroll-view scroll-y class="tool-io-scroll">
        <text class="tool-io-text mono {{view.failed ? 'tool-io-text-error' : ''}}">{{view.output}}</text>
      </scroll-view>
    </view>
    <view wx:if="{{view.sourceSeq}}" class="tool-inspect" data-anchor="tool.inspect" catchtap="inspect">
      <dsh-icon name="inspect-outline" tone="tertiary" theme="{{theme}}" size="{{12}}" />
      <text>查看</text>
    </view>
  </view>
</view>
