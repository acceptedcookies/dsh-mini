<view wx:if="{{visible}}" class="layout-{{layout}} right-panel {{docked ? 'right-panel-docked' : ''}}" data-anchor-exempt="gesture-shield" catchtap="noop" style="{{shellVars}}">
  <view class="rp-strip">
    <dsh-tabs class="rp-tabs" variant="pill" tabs="{{tabs}}" active="{{active}}" theme="{{theme}}" bind:change="select" />
    <view class="rp-close" data-anchor="rp.close" bindtap="close">
      <dsh-icon name="close-outline" theme="{{theme}}" size="{{14}}" />
    </view>
  </view>

  <scroll-view class="rp-body" scroll-y enhanced show-scrollbar="{{false}}">
    <block wx:if="{{active === 'files'}}">
      <view class="rp-nav">
        <view wx:if="{{!connected && navPath !== '/'}}" class="rp-action rp-back" data-anchor="rp.back" bindtap="onNavBack">
          <dsh-icon name="chevron-left-outline" theme="{{theme}}" size="{{16}}" />
        </view>
        <view class="rp-nav-main">
          <text class="rp-nav-path mono">{{connected ? 'workspace' : navPath}}</text>
          <text class="rp-nav-lane">{{connected ? '云端 nano 工作区 · 只读' : '本地 VFS · 五根'}}</text>
        </view>
        <view class="rp-action" data-anchor="rp.refresh" bindtap="refresh">
          <dsh-icon name="refresh-outline" theme="{{theme}}" size="{{14}}" />
        </view>
      </view>
      <view wx:if="{{loading || navLoading}}" class="rp-note">正在读取工作区文件…</view>
      <view wx:elif="{{error || navErr}}" class="rp-note rp-error">{{error || navErr}}</view>
      <view wx:elif="{{!fileRows.length}}" class="rp-empty">
        <text class="rp-empty-title">{{connected ? '工作区没有文件' : '目录为空'}}</text>
        <text class="rp-empty-copy">{{connected ? '当前会话的 workspace 为空。' : '此目录下没有条目。'}}</text>
      </view>
      <view wx:else class="fm-list">
        <view
          wx:for="{{fileRows}}"
          wx:key="path"
          class="fm-row"
          data-anchor="rp.row"
          data-path="{{item.path}}"
          data-kind="{{item.kind}}"
          bindtap="onRowTap"
        >
          <dsh-icon class="fm-icon" name="{{item.icon}}" theme="{{theme}}" size="{{18}}" />
          <view class="fm-main">
            <text class="fm-name">{{item.name}}</text>
            <text wx:if="{{item.meta}}" class="fm-meta">{{item.meta}}</text>
          </view>
          <text wx:if="{{item.syncLabel}}" class="fm-badge fm-badge-{{item.syncState}}">{{item.syncLabel}}</text>
          <view
            wx:if="{{item.kind === 'file'}}"
            class="fm-menu"
            data-anchor="rp.rowMenu"
            data-path="{{item.path}}"
            catchtap="onRowMenu"
          >
            <dsh-icon name="ellipsis-outline" theme="{{theme}}" size="{{16}}" />
          </view>
          <dsh-icon wx:else class="fm-chev" name="chevron-right-outline" tone="tertiary" theme="{{theme}}" size="{{13}}" />
        </view>
      </view>
    </block>

    <block wx:elif="{{active === 'terminal'}}">
      <view class="rp-head">
        <text class="rp-title">终端</text>
        <view class="rp-action" data-anchor-exempt="noop" bindtap="noop">
          <dsh-icon name="plus-outline" theme="{{theme}}" size="{{14}}" />
        </view>
      </view>
      <view class="terminal-box">
        <view class="term-line"><text class="term-prompt">$</text> pnpm test</view>
        <view class="term-muted">{{connected ? 'nano-agent 当前不暴露 PTY 终端。' : '本地运行时不提供 PTY。登录 nano-agent 后仍以远端能力为准。'}}</view>
      </view>
    </block>

    <block wx:elif="{{active === 'browser'}}">
      <view class="browser-bar">
        <dsh-icon name="globe-outline" theme="{{theme}}" size="{{14}}" />
        <input class="browser-input" placeholder="输入 URL" placeholder-class="rp-placeholder" adjust-position="{{false}}" />
      </view>
      <view class="rp-empty">
        <text class="rp-empty-title">浏览器面板</text>
        <text class="rp-empty-copy">{{connected ? 'nano-agent 当前不暴露 browser-use。' : '登录后由远端 runtime 能力决定。'}}</text>
      </view>
    </block>

    <block wx:elif="{{active === 'jobs'}}">
      <view class="rp-head"><text class="rp-title">后台任务</text></view>
      <view class="rp-empty">
        <text class="rp-empty-title">没有后台任务</text>
        <text class="rp-empty-copy">{{connected ? 'nano-agent 当前不暴露后台任务列表。' : '登录后由远端 runtime 能力决定。'}}</text>
      </view>
    </block>

    <block wx:elif="{{active === 'plan'}}">
      <view class="rp-head"><text class="rp-title">计划</text></view>
      <view wx:if="{{loading}}" class="rp-note">正在读取会话计划…</view>
      <view wx:elif="{{error}}" class="rp-note rp-error">{{error}}</view>
      <view wx:elif="{{!todos.length}}" class="rp-empty">
        <text class="rp-empty-title">当前会话没有计划</text>
        <text class="rp-empty-copy">{{connected ? 'Agent 写入的 todo 会出现在这里。' : '登录 nano-agent 后显示真实会话计划。'}}</text>
      </view>
      <view wx:else class="todo-list">
        <view wx:for="{{todos}}" wx:key="id" class="todo-row">
          <view class="todo-dot todo-{{item.status}}"></view>
          <text class="todo-content">{{item.content}}</text>
          <text class="todo-status">{{item.status}}</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="rp-head"><text class="rp-title">团队</text></view>
      <view class="rp-empty">
        <text class="rp-empty-title">没有子 agent</text>
        <text class="rp-empty-copy">{{connected ? 'nano-agent 当前不暴露 Agent Team 面板。' : '登录后由远端 runtime 能力决定。'}}</text>
      </view>
    </block>
  </scroll-view>

  <!-- 文件卡片：信息行 + 操作列（标准 dsh-dialog，替原生 ActionSheet/showModal）。 -->
  <dsh-dialog
    visible="{{cardPath !== ''}}"
    title="{{cardTitle}}"
    theme="{{theme}}"
    cancelText="关闭"
    confirmText=""
    bind:cancel="closeCard"
  >
    <view class="fmd-info">
      <view wx:for="{{cardInfo}}" wx:key="label" class="fmd-row">
        <text class="fmd-label">{{item.label}}</text>
        <text class="fmd-value" user-select>{{item.value}}</text>
      </view>
    </view>
    <view class="fmd-actions">
      <view wx:if="{{cardWritable}}" class="fmd-act" data-anchor="rp.cardRename" bindtap="onCardRename">
        <dsh-icon name="edit-outline" tone="tertiary" theme="{{theme}}" size="{{15}}" />
        <text class="fmd-act-label">重命名</text>
      </view>
      <view class="fmd-act" data-anchor="rp.cardCopy" bindtap="onCardCopy">
        <dsh-icon name="copy-outline" tone="tertiary" theme="{{theme}}" size="{{15}}" />
        <text class="fmd-act-label">复制路径</text>
      </view>
      <view wx:if="{{cardWritable}}" class="fmd-act fmd-act-danger" data-anchor="rp.cardDelete" bindtap="onCardDelete">
        <dsh-icon name="trash-outline" tone="danger" theme="{{theme}}" size="{{15}}" />
        <text class="fmd-act-label">删除</text>
      </view>
    </view>
  </dsh-dialog>

  <dsh-dialog
    visible="{{renameVisible}}"
    title="重命名"
    theme="{{theme}}"
    editable
    value="{{renameValue}}"
    placeholder="文件名"
    cancelText="取消"
    confirmText="重命名"
    bind:cancel="onRenameCancel"
    bind:confirm="onRenameConfirm"
  />

  <dsh-dialog
    visible="{{deleteVisible}}"
    title="删除文件"
    description="{{deleteDesc}}"
    theme="{{theme}}"
    danger
    cancelText="取消"
    confirmText="删除"
    bind:cancel="onDeleteCancel"
    bind:confirm="onDeleteConfirm"
  />
</view>
