<view wx:if="{{render}}" class="toast theme-{{theme}} {{closing ? 'toast-closing' : ''}}">
  <dsh-icon
    wx:if="{{tone === 'success' || tone === 'warning' || tone === 'error'}}"
    name="{{tone === 'success' ? 'check-circle-outline' : (tone === 'error' ? 'close-circle-fill' : 'warning-triangle-outline')}}"
    tone="{{tone === 'success' ? 'accent' : (tone === 'error' ? 'danger' : 'warn')}}"
    theme="{{theme}}"
    size="{{16}}"
  />
  <text class="toast-text">{{message}}</text>
</view>
