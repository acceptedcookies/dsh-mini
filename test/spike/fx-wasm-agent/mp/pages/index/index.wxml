<view class="page">
  <view class="row">
    <input class="input" value="{{prompt}}" bindinput="onInput" placeholder="prompt" />
    <button class="btn" bindtap="onSend" disabled="{{busy}}">发送</button>
  </view>
  <view class="status">status: {{status}}</view>
  <scroll-view scroll-y class="output" scroll-into-view="{{'o'+output.length}}">
    <text user-select>{{output}}</text>
  </scroll-view>
  <scroll-view scroll-y class="log">
    <text user-select>{{log}}</text>
  </scroll-view>
</view>
